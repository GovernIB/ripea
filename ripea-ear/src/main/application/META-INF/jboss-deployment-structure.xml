<?xml version='1.0' encoding='UTF-8'?>
<jboss-deployment-structure xmlns="urn:jboss:deployment-structure:1.2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
<!-- https://github.com/wildfly/wildfly-core/blob/main/server/src/main/resources/schema/jboss-deployment-structure-1_2.xsd -->
	<deployment>
		<dependencies>
<!-- 			<module name="org.keycloak.keycloak-core" export="true"/> -->
			<!-- Llibreries mínimes (4) perque funcionin els WS securitzats -->
			<module name="org.apache.cxf.impl"/>
			<module name="org.apache.ws.security"/>
			<module name="org.apache.santuario.xmlsec"/>
			<module name="org.bouncycastle"/>
<!-- 			<module name="io.undertow.core" export="true"/> -->
<!-- 			<module name="io.undertow.servlet" export="true"/> -->
<!-- 			<module name="io.undertow.websocket" export="true"/> -->
			<!-- Modul necessari per el monitor del sistema MonitorHelper -->
			<module name="jdk.management"/>
		</dependencies>
		<exclude-subsystems>
			<!-- Excloent aquest subsystem fa que s'utilitzin els jars de jackson que venen amb el projecte i evitam errors -->
			<subsystem name="jaxrs"/>
		</exclude-subsystems>
	</deployment>
	<sub-deployment name="ripea-back.war">
		<!-- Exclou el modul EJB3 de JBoss del classloader d'aquest WAR per evitar
		     que PathMatchingResourcePatternResolver (Spring HATEOAS) intenti accedir
		     al directori "timers" durant l'escaneig del classpath a l'arrencada.
		     Les crides als EJB segueixen funcionant (LocalStatelessSessionProxyFactoryBean
		     resol per JNDI, no per aquest modul). -->
		<exclusions>
			<module name="org.jboss.as.ejb3"/>
		</exclusions>
		<dependencies>
			<module name="jdk.management"/>
		</dependencies>
	</sub-deployment>
	<sub-deployment name="ripea-api-interna.war">
		<!-- Mateixa exclusio que ripea-back.war: el descriptor de l'EAR es l'unic
		     que JBoss processa; els jboss-deployment-structure.xml dins dels WAR
		     (WEB-INF) s'ignoren quan existeix aquest a nivell d'EAR. -->
		<exclusions>
			<module name="org.jboss.as.ejb3"/>
		</exclusions>
	</sub-deployment>
	<ear-subdeployments-isolated>false</ear-subdeployments-isolated>
</jboss-deployment-structure>