<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
        <!-- Filtra els errors esperats dels tests (excepcions intencionades) -->
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>WARN</level>
        </filter>
    </appender>

    <!-- Silencia els errors esperats del helper (excepcions de distribució, sequencies, etc.) -->
    <logger name="es.caib.ripea.service.helper.MetaExpedientHelper" level="OFF" />

    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>
