		<!-- Perfil de cobertura de codi.
		     Activa'l amb: mvn package -P cobertura  (tests unitaris + informe)
		                   mvn install -P cobertura  (tests unitaris + ITs + informes)
		     Requereix que org.jacoco:jacoco-maven-plugin:0.8.12 i les seves
		     dependències estiguin disponibles al repositori Maven. -->
		<profile>
			<id>cobertura</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.jacoco</groupId>
						<artifactId>jacoco-maven-plugin</artifactId>
						<version>0.8.12</version>
						<executions>
							<!-- Injecta l'agent JVM per als tests unitaris (surefire) -->
							<execution>
								<id>jacoco-prepare-agent</id>
								<goals>
									<goal>prepare-agent</goal>
								</goals>
								<configuration>
									<propertyName>jacoco.surefire.argLine</propertyName>
								</configuration>
							</execution>
							<!-- Injecta l'agent JVM per als tests d'integració (failsafe) -->
							<execution>
								<id>jacoco-prepare-agent-integration</id>
								<goals>
									<goal>prepare-agent-integration</goal>
								</goals>
								<configuration>
									<propertyName>jacoco.failsafe.argLine</propertyName>
								</configuration>
							</execution>
							<!-- Informe de tests unitaris: target/site/jacoco/ -->
							<execution>
								<id>jacoco-report</id>
								<phase>test</phase>
								<goals>
									<goal>report</goal>
								</goals>
								<configuration>
									<outputDirectory>${project.reporting.outputDirectory}/jacoco</outputDirectory>
								</configuration>
							</execution>
							<!-- Informe de tests d'integració: target/site/jacoco-it/ -->
							<execution>
								<id>jacoco-report-integration</id>
								<phase>post-integration-test</phase>
								<goals>
									<goal>report-integration</goal>
								</goals>
								<configuration>
									<outputDirectory>${project.reporting.outputDirectory}/jacoco-it</outputDirectory>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
