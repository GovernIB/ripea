	<build>
		<plugins>
			<!-- Tests unitaris: s'executen a la fase 'test' (inclosa en 'package').
			     Exclou els tests d'integració (*IT) perquè els gestiona Failsafe. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>**/*IT.java</exclude>
					</excludes>
					<!-- Orika (i altres llibreries de generació de bytecode) necessiten
					     accedir a ClassLoader.defineClass, blocat per defecte a Java 11. -->
					<argLine>
						@{jacoco.surefire.argLine}
						--add-opens java.base/java.lang=ALL-UNNAMED
						--add-opens java.base/java.util=ALL-UNNAMED
						--add-opens java.base/java.lang.reflect=ALL-UNNAMED
					</argLine>
				</configuration>
			</plugin>

			<!-- Tests d'integració: s'executen a la fase 'verify' (inclosa en 'install').
			     Inclou només els tests *IT. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
				<configuration>
					<includes>
						<include>**/*IT.java</include>
					</includes>
					<argLine>
						@{jacoco.failsafe.argLine}
						--add-opens java.base/java.lang=ALL-UNNAMED
						--add-opens java.base/java.util=ALL-UNNAMED
						--add-opens java.base/java.lang.reflect=ALL-UNNAMED
					</argLine>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>integration-test</goal>
							<goal>verify</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

		</plugins>
	</build>

	<profiles>
